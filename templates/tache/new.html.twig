{% extends 'base.html.twig' %}

{% block title %}New Tache{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(135deg, #f0f4ff, #dbeafe);
        font-family: Arial, sans-serif;
        color: #333;
    }

    .container-tache {
        max-width: 600px;
        margin: 60px auto;
        padding: 30px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        text-align: center;
    }

    .container-tache h1 {
        color: #2563eb;
        margin-bottom: 20px;
        font-size: 2rem;
    }

    /* Styles des labels */
    .container-tache label {
        display: block;
        font-weight: bold;
        color: #1e3a8a; /* bleu foncé */
        margin-bottom: 6px;
        font-size: 1rem;
        text-align: left;
    }

    /* Styles des champs input et select */
    .container-tache input,
    .container-tache select,
    .container-tache textarea {
        width: 100%;
        padding: 10px 12px;
        margin-bottom: 15px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

    .container-tache input:focus,
    .container-tache select:focus,
    .container-tache textarea:focus {
        border-color: #2563eb;
        box-shadow: 0 0 5px rgba(37, 99, 235, 0.4);
    }

    /* Bouton back to list */
    .container-tache a {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 18px;
        background: #2563eb;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .container-tache a:hover {
        background: #1e40af;
        transform: scale(1.05);
    }
</style>

<div class="container-tache">
    <h1>Create new Tache</h1>

    {{ include('tache/_form.html.twig') }}

    <a href="{{ path('app_tache_index') }}">⬅ Back to list</a>
</div>
{% endblock %}
