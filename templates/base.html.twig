<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}gestionnaire de Tache{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    {% if app.request.attributes.get('_route') == 'app_login' %}
        <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    {% endif %}
    {% if app.request.attributes.get('_route') == 'app_tache_index' %}
            <link rel="stylesheet" href="{{ asset('css/tache.css') }}">
    {% endif %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="/">gestionnaire de Tache</a>
        {% if app.user %}
            <span class="text-light me-3">Bienvenue, {{ app.user.email }}</span>
            <a href="{{ path('app_logout') }}" class="btn btn-outline-light">Déconnexion</a>
        {% else %}
            
            <a href="{{ path('app_register') }}" class="btn btn-outline-light">S'inscrire</a>
        {% endif %}
    </nav>
    <div class="container mt-4">
        {% block body %}{% endblock %}
    </div>
</body>
</html>
